// Function to chunk data into pages
function generatePages(data, surahTitle) {
    const pages = [];
    for (let i = 0; i < data.length; i += 2) {
        const verse1 = data[i];
        const verse2 = data[i+1];
        
        pages.push({
            title: surahTitle,
            verses: verse2 ? [verse1, verse2] : [verse1]
        });
    }
    return pages;
}

